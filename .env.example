# Salin file ini menjadi .env.local, lalu isi nilainya.
# JANGAN commit .env.local.

# Aman dipakai di browser (dilindungi RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA: hanya untuk API route dan skrip, jangan pernah dipakai di komponen browser
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Akun demo untuk /api/demo-login
DEMO_WARGA_EMAIL=
DEMO_WARGA_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Untuk skrip Python (koneksi langsung ke Postgres Supabase)
DATABASE_URL=
